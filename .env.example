# Copy to .env (Docker / local) and fill in. Never commit real secrets.

# --- Database ------------------------------------------------------------------
# Neon: pooled URL for the app, direct URL for migrations.
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Local Postgres from docker-compose (`db` service). Inside Docker use host "db".
DATABASE_URL="postgresql://strapolary:strapolary@db:5432/strapolary"

# --- Public URL ------------------------------------------------------------------
APP_URL="http://localhost:3000"

# --- Auth.js -----------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# GitHub OAuth app: callback URL = {APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Google OAuth client (optional): callback URL = {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Stripe ------------------------------------------------------------------------
# Use test keys (sk_test_...) until you go live.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the dashboard.
STRIPE_WEBHOOK_SECRET=""
